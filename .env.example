# Site URL for SEO (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional Cal.com / booking URL for "Book a call" (falls back to LinkedIn)
NEXT_PUBLIC_CAL_URL=https://cal.com/your-username

# Resend SMTP (optional — contact form falls back to local mock without this)
# API keys start with re_  — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="Hamza Ahmed <beth.t@example.com>"
CONTACT_TO_EMAIL=you@example.com

# Private jobs tool (/jobs + /api/jobs/*) — leave unset/false on public portfolio
ENABLE_JOBS=false

# Discord Webhook Integration for React Native Job Alert System (optional — can also be configured dynamically in the /jobs settings panel)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
